# ---- LLM provider (OpenAI-compatible) ----
# No real values here. Copy to .env and fill locally. .env is git-ignored.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Feature flags ----
# When true, the app runs fully offline using deterministic fallbacks.
DEMO_MODE=true
EMBEDDINGS_ENABLED=false

# ---- Storage ----
# Local/dev & tests default to SQLite for deterministic offline runs.
DATABASE_URL=sqlite:///./outputs/ai_data_guardian.db
WORKSPACE_DIR=./outputs

# ---- Supabase ----
# Client-exposed values (safe in the browser). MUST use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (full access, bypasses RLS). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres connection string (only if bypassing supabase-js).
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=workspaces

# ---- Deployment (Vercel) ----
# Set automatically by Vercel in the cloud; used locally to distinguish environments.
VERCEL_ENV=development

# ---- Observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
